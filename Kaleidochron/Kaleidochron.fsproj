<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>
  
  <ItemGroup>
    <Compile Include="LinearClock\LinearClockControl.fs" />
    <Compile Include="LinearClock\LinearClock.fs" />
    <Compile Include="AppBarInterop.fs" />
    <Compile Include="Shell.fs" />
    <Compile Include="App.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.FuncUI" Version="2.0.0-preview1" />
    <PackageReference Include="Avalonia.FuncUI.Elmish" Version="2.0.0-preview1" />
    <PackageReference Include="Avalonia.Markup.Declarative" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Vanara.PInvoke.Shell32" Version="5.0.5" />
    <PackageReference Include="Vanara.PInvoke.User32" Version="5.0.5" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="**\*.xaml" />
  </ItemGroup>

</Project>
